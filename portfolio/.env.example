# Copy to `.env` to enable real email delivery from the contact form.
# Without these the form validates and then falls back to opening a
# prefilled mail draft, so it still works on a purely static host.

# Get a key at https://resend.com (free tier is plenty for a portfolio)
NUXT_RESEND_API_KEY=

# Where contact messages are delivered
NUXT_CONTACT_TO=sdipu231@gmail.com

# Used for canonical/OG URLs once you have a domain
NUXT_PUBLIC_SITE_URL=https://dipusharma.dev
